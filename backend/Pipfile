[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = ">=0.104.0"
uvicorn = ">=0.24.0"
pydantic = ">=2.4.2"
pydantic-settings = ">=2.0.3"
python-dotenv = ">=1.0.0"
motor = ">=3.3.1"
python-multipart = ">=0.0.6"
python-json-logger = ">=2.0.7"
starlette = ">=0.27.0"  # Required for middleware
structlog = ">=23.1.0"  # For structured logging
asgi-correlation-id = ">=4.0.0"  # For request ID tracking
orjson = ">=3.9.10"  # For faster JSON serialization
sse-starlette = ">=1.8.2"  # For Server-Sent Events
boto3 = ">=1.34.0"
sqlalchemy = ">=2.0.0"
asyncpg = ">=0.29.0"
greenlet = ">=3.0.0"
# No langchain and no langgraph. The Agents SDK owns the model call and the
# tool loop; openai is here because llm_service registers a client with it.
openai = ">=1.0"
openai-agents = ">=0.19,<1.0"
networkx = ">=3.0"  # task-graph topology in dag_service
# No alembic and no sync driver. There are no migrations: postgres_service
# creates missing tables at startup and a model change means `down -v`.
pandas = ">=2.0"  # dataframes: profiling, artifacts, generated analysis code
pyarrow = ">=15.0"  # parquet encoding for frame artifacts
# Plot rendering inside the sandbox. Generated code saves figures into `out`,
# and without this an analyst asked for a chart image fails on the import.
matplotlib = ">=3.8"

[dev-packages]
debugpy = "==1.8.0"
pytest = ">=7.4.0"
pytest-asyncio = ">=0.21.0"
black = ">=23.9.0"
isort = ">=5.12.0"
flake8 = ">=6.1.0"
mypy = ">=1.5.0"

[requires]
python_version = "3.11"
