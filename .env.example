# Copy to .env and fill in OPENAI_API_KEY. Everything else works as-is
# against the services defined in docker-compose.yml.

# --- required ---
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o.
LLM_MODEL=
MAX_TOKENS=8000

# --- postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentics
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- backend ---
# Auth off by default: with this true the stack needs no AWS account at all.
# The client has its own NEXT_PUBLIC_DISABLE_AUTH in .env.client; both must agree.
DISABLE_AUTH=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
MAX_TASK_ATTEMPTS=3
DISPATCH_MAX_CONCURRENCY=4
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY_MB=2048
LOG_LEVEL=INFO

# --- aws: only needed for Cognito auth.
# Leave blank and set NEXT_PUBLIC_DISABLE_AUTH=true to run without an AWS account.
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
DEFAULT_AWS_REGION=us-west-2

# --- object storage: 'local' needs no AWS ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/var/lib/agentics/storage
# Largest accepted CSV upload, in bytes. Read into memory whole.
MAX_UPLOAD_BYTES=104857600

# Bounds on what one request can spend: each retry is another model call.
MAX_CODE_ATTEMPTS=3
MAX_PLANNING_ATTEMPTS=3
# 64KB is the SQS message limit, which is what a task envelope must fit in.
MAX_ENVELOPE_BYTES=65536


# --- pgadmin ---
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
