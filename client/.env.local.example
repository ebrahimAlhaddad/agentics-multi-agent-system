# Copy to client/.env.local — Next.js reads .env.local from this directory.
# (It does not read the repo-root .env; NEXT_PUBLIC_* values are inlined at
# build time, so the dev server must be restarted after changing them.)

NEXT_PUBLIC_BACKEND_URL=http://localhost:8001

# Skips Cognito entirely. With this false you need real Amplify outputs
# (npx ampx sandbox), which needs an AWS account.
NEXT_PUBLIC_DISABLE_AUTH=true

NEXT_PUBLIC_EXECUTION_LOG_SIZE=25
NEXT_PUBLIC_MAX_RETRIES=3
